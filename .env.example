# ==============================================================================
# RecoverAI Frontend Environment Configuration
# ==============================================================================
# IMPORTANT: Only client-safe, public variables belong here (prefixed with NEXT_PUBLIC_).
# Secrets like RAZORPAY_KEY_SECRET, LLM_API_KEY, and DATABASE_URL belong strictly
# in the backend (Python/FastAPI) service environment.
# ==============================================================================

# Backend API Base URL (empty uses the built-in mock service layer)
# Localhost Docker: http://localhost:8000
# Production Netlify: https://<your-backend-domain>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Environment (development, staging, production)
NEXT_PUBLIC_APP_ENV=development

# Demo Mode Enabled (true enables simulation controls and scenario switchers)
NEXT_PUBLIC_DEMO_MODE=true

# Merchant ID Context (Default Canonical Merchant UUID)
NEXT_PUBLIC_DEFAULT_MERCHANT_ID=00000000-0000-0000-0000-000000000001
