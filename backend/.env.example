# ==============================================================================
# RecoverAI Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in local development:
#   cp .env.example .env
# Never commit .env with production credentials to source control.
# ==============================================================================

# Application Metadata
APP_NAME=RecoverAI API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with asyncpg driver)
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/recover_ai
# Production Render / Managed DB: postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recover_ai

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# CORS Configuration (comma-separated list of allowed origins)
# Production: CORS_ALLOWED_ORIGINS=https://recover-ai.netlify.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Documentation & OpenAPI
DOCS_ENABLED=true

# Phase 6: AI Diagnostic Copilot Configuration (Optional cloud LLM provider)
AI_ENABLED=true
AI_PROVIDER=mock
AI_DEMO_MODE=true
AI_API_KEY=
