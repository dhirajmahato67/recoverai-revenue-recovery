# Multi-stage Dockerfile for Next.js frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Build arguments for Next.js client-side public environment variables
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_APP_ENV=development
ARG NEXT_PUBLIC_DEMO_MODE=true
ARG NEXT_PUBLIC_DEFAULT_MERCHANT_ID=00000000-0000-0000-0000-000000000001

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV}
ENV NEXT_PUBLIC_DEMO_MODE=${NEXT_PUBLIC_DEMO_MODE}
ENV NEXT_PUBLIC_DEFAULT_MERCHANT_ID=${NEXT_PUBLIC_DEFAULT_MERCHANT_ID}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["npm", "run", "start"]
